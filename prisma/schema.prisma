generator client {
  provider        = "prisma-client"
  previewFeatures = ["strictUndefinedChecks"]
  output          = "../shared/generated/"
  engineType      = "client"
}

// generator kysely {
//   provider = "prisma-kysely"

//   output   = "../types"
//   fileName = "kysely.ts"
// }

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(cuid(2))

  givenName  String @default("") // first name
  familyName String @default("") // last name

  emailAddress String  @unique
  // Null for accounts created through an OAuth provider such as ORCID. Such a
  // user can still set one later through forgot password or the profile page.
  password     String?

  emailVerified                 Boolean   @default(false)
  emailVerifiedAt               DateTime?
  emailVerificationToken        String?   @unique
  emailVerificationTokenExpires DateTime?

  role String @default("user") // user | admin

  // Public profile. Opt-in, so a profile stays private until the user turns
  // it on. profileId is the whole profile address, /profile/<profileId>, and
  // never changes. It is assigned the first time the profile is made public
  // or the owner opens /profile/me.
  profilePublic    Boolean @default(false)
  profileId        String? @unique
  affiliation      String  @default("")
  bio              String  @default("")
  // Opt-in: show the posters this user liked on their public profile.
  profileShowLikes Boolean @default(false)
  // ORCID iD the user typed in on their settings page, stored bare
  // (0000-0002-1825-0097) or "" when unset.
  orcid            String  @default("")

  created           DateTime          @default(now())
  updated           DateTime          @updatedAt
  Poster            Poster[]
  extractionBatches ExtractionBatch[]

  ZenodoToken       ZenodoToken?
  ZenodoDepositions ZenodoDeposition[]

  linkedAccounts LinkedAccount[]
  posterClaims   PosterClaim[]

  organizationMemberships OrganizationMember[]
  organizationInvitesSent OrganizationInvite[]
  organizationPosters     OrganizationPoster[]

  likes Like[] @relation("UserLikes")

  userEmailVerifications UserEmailVerification[]
  userForgotPasswords    UserForgotPassword[]

  adminAuditLogs AdminAuditLog[] @relation("AdminActions")

  bulkSubmissions BulkSubmission[]
  maintenanceFlagUpdates MaintenanceFlag[] @relation("MaintenanceFlagUpdates")

  @@index([emailAddress])
}

model UserEmailVerification {
  id String @id @default(cuid(2))

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  verificationToken String   @unique
  expiresAt         DateTime

  created DateTime @default(now())
  updated DateTime @updatedAt
}

model UserForgotPassword {
  id String @id @default(cuid(2))

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  resetToken String   @unique
  expiresAt  DateTime

  created DateTime @default(now())
  updated DateTime @updatedAt
}

model UserInterest {
  id String @id @default(cuid(2))

  emailAddress String @unique

  created DateTime @default(now())

  @@index([emailAddress])
}

model Poster {
  id Int @id @default(autoincrement())

  // Published poster versions are stored as separate rows while sharing the
  // first poster's stable public identity. Root rows leave versionRootId
  // null; every later version points directly at that root.
  versionRoot     Poster?  @relation("PosterVersions", fields: [versionRootId], references: [id], onDelete: Cascade)
  versionRootId   Int?
  versions        Poster[] @relation("PosterVersions")
  // Internal ordering slot reserved when a draft is created. This is not the
  // user-facing PosterMetadata.version value.
  versionSequence Int      @default(1)
  isLatestVersion Boolean  @default(true)

  title       String
  description String

  imageUrl String

  status      String    @default("draft") // draft, downloaded, published
  publishedAt DateTime?

  user   User   @relation(fields: [userId], references: [id])
  userId String

  randomInt Int @default(0) // a field to touch when data in a related table is updated - For sorting by last updated

  created DateTime @default(now())
  updated DateTime @updatedAt

  posterMetadata    PosterMetadata?
  zenodoDepositions ZenodoDeposition?

  extractionJob ExtractionJob?

  automated Boolean @default(false) // Whether the poster was created through automated extraction or manual submission

  tombstone    Boolean @default(false) // true = retired/soft-deleted, hidden from public views
  tombedReason String  @default("") // Why the poster was retired

  likes Like[] @relation("PosterLikes")

  claims PosterClaim[]

  organizationListings OrganizationPoster[]

  @@unique([versionRootId, versionSequence])
  @@index([versionRootId, status])
  @@index([status, tombstone, isLatestVersion])
}

model PosterMetadata {
  poster   Poster @relation(fields: [posterId], references: [id], onDelete: Cascade)
  posterId Int    @id

  doi String?

  identifiers Json @default("[]") // [{ identifier: string, identifierType: string }]

  creators Json @default("[]") // [{ name: string, nameType: string, nameIdentifiers: string[], affiliation: string[] }]

  publisher       String?
  publicationYear Int?

  subjects String[] @default([])

  domain   String?
  language String?
  version  String?

  size   String?
  format String?

  license String? // SPDX identifier

  fundingReferences Json @default("[]") // [{ funderName: string, funderIdentifier: string, funderIdentifierType: string, schemeUri: string, awardNumber: string, awardUri: string, awardTitle: string }]

  conferenceName           String?
  conferenceLocation       String?
  conferenceUri            String?
  conferenceIdentifier     String?
  conferenceIdentifierType String?
  conferenceYear           Int?
  conferenceStartDate      String?
  conferenceEndDate        String?
  conferenceAcronym        String?
  conferenceSeries         String?

  dates Json @default("[]") // [{ date: string, dateType: string }] primarily for autoindexed posters

  relatedIdentifiers Json @default("[]") // [{ relatedIdentifier: string, relatedIdentifierType: string, relationType: string }]

  posterContent Json @default("[]") // { sections: [{ sectionTitle: string, sectionContent: string }], unstructuredContent: string }
  tableCaptions Json @default("[]") // [{ id: string, caption: string }]
  imageCaptions Json @default("[]") // [{ id: string, caption: string }]

  created DateTime @default(now())
  updated DateTime @updatedAt
}

model Like {
  user   User   @relation("UserLikes", fields: [userId], references: [id], onDelete: Cascade)
  userId String

  poster   Poster @relation("PosterLikes", fields: [posterId], references: [id], onDelete: Cascade)
  posterId Int

  created DateTime @default(now())
  updated DateTime @updatedAt

  @@id([userId, posterId])
}

// An external identity the user has proven they own, used to sign in and,
// later, to verify poster claims. One row per provider per user, and a given
// provider identity (an ORCID iD, say) can belong to only one account.
model LinkedAccount {
  id String @id @default(cuid(2))

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  provider          String // orcid
  providerAccountId String // the ORCID iD, e.g. 0000-0002-1825-0097

  linkedAt DateTime @default(now())
  updated  DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
}

// A user saying "I am an author of this poster". Claims are approved as soon
// as they are made, are not tied to a creator name, and only grant the author
// role: the poster shows on the user's profile and dashboard, but ownership
// (Poster.userId), editing and publishing are unchanged. Any number of users
// can claim the same poster. An admin can revoke a claim, which deletes the row.
model PosterClaim {
  id String @id @default(cuid(2))

  // Always the version root, so one claim covers every version of the poster.
  poster   Poster @relation(fields: [posterId], references: [id], onDelete: Cascade)
  posterId Int

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  role String @default("author") // author for now; manager comes later

  created DateTime @default(now())

  @@unique([posterId, userId])
  @@index([userId])
}

// A lab, institute, society or other group with its own public page. An
// organization never signs in and has no role, so it can't be an admin. It shows
// posters but never owns them: Poster.userId stays the owner, and only that
// person can edit or publish the poster.
model Organization {
  id String @id @default(cuid(2))

  // The whole public address, /org/<profileId>. It is random and never changes,
  // so a link keeps working if the organization is renamed.
  profileId String @unique

  name        String
  description String @default("")
  websiteUrl  String @default("")

  // Private until an owner makes it public, like a user profile.
  profilePublic Boolean @default(false)

  // Whether the public page says how many members there are. Members are never
  // named there, and members always see the count.
  showMemberCount Boolean @default(true)

  // Set when an admin takes the page down. Wins over profilePublic.
  hiddenAt     DateTime?
  hiddenReason String    @default("")

  created DateTime @default(now())
  updated DateTime @updatedAt

  members OrganizationMember[]
  invites OrganizationInvite[]
  posters OrganizationPoster[]
}

model OrganizationMember {
  id String @id @default(cuid(2))

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  role String @default("member") // owner | member

  created DateTime @default(now())

  @@unique([organizationId, userId])
  @@index([userId])
}

// An invitation to join, accepted by the person whose verified account email
// matches. Accepting or declining deletes the row.
model OrganizationInvite {
  id String @id @default(cuid(2))

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  emailAddress String // lower case

  invitedBy   User   @relation(fields: [invitedById], references: [id], onDelete: Cascade)
  invitedById String

  expiresAt DateTime

  created DateTime @default(now())

  @@unique([organizationId, emailAddress])
  @@index([emailAddress])
}

// A poster shown on an organization's page. This grants the organization no
// rights over the poster. Removing the row only takes it off the page.
model OrganizationPoster {
  id String @id @default(cuid(2))

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  // Always the version root, so a new version appears on the page by itself.
  poster   Poster @relation(fields: [posterId], references: [id], onDelete: Cascade)
  posterId Int

  addedBy   User   @relation(fields: [addedById], references: [id], onDelete: Cascade)
  addedById String

  created DateTime @default(now())

  @@unique([organizationId, posterId])
  @@index([posterId])
  @@index([addedById])
}

model ZenodoToken {
  id String @id @default(cuid(2))

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  // oauth: issued by the Zenodo OAuth flow, expires and comes with a refresh
  // token. personal: a personal access token the user pasted in, which has no
  // refresh token and is deleted an hour after it is connected
  // (server/plugins/zenodoPersonalTokenPurge.ts).
  tokenType String @default("oauth") // oauth | personal

  // Both tokens are encrypted at rest (server/utils/zenodoTokenCrypto.ts).
  // Rows written before encryption was added still hold plain text and are
  // read as is.
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?

  created DateTime @default(now())
  updated DateTime @updatedAt

  @@index([userId])
}

model ZenodoDeposition {
  id String @id @default(cuid(2))

  depositionId           Int     @unique // Last published Zenodo deposition ID
  status                 String  @default("unpublished") // draft, published, unpublished
  lastPublishedZenodoDoi String? // Last published Zenodo DOI
  /** ISO date (YYYY-MM-DD, UTC) when Zenodo file download embargo ends; null if files are public. */
  filesEmbargoUntil      String?

  user   User   @relation(fields: [userId], references: [id])
  userId String

  poster   Poster @relation(fields: [posterId], references: [id], onDelete: Cascade)
  posterId Int    @unique

  created DateTime @default(now())
  updated DateTime @updatedAt
}

model AdminAuditLog {
  id String @id @default(cuid(2))

  adminUser   User   @relation("AdminActions", fields: [adminUserId], references: [id])
  adminUserId String

  action     String // e.g. DELETE_POSTER, UPDATE_USER_ROLE
  entityType String // user | poster
  entityId   String

  details Json?

  created DateTime @default(now())

  @@index([adminUserId])
  @@index([entityType])
  @@index([created])
}

model MetricsSnapshot {
  id Int @id @default(autoincrement())

  payload Json

  generatedAt DateTime @default(now())

  @@index([generatedAt])
}

/// In-progress bulk poster import (wizard state). Distinct from `ExtractionJob` per poster.
model BulkSubmission {
  id String @id @default(cuid(2))

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  name String

  // setup | upload | conference | submit
  wizardStep String @default("upload")
  // draft | processing | completed | failed
  status String @default("draft")
  stagedPosters Json @default("[]")

  licenseMetadataFileName String?
  licenseMetadataFilePath String?

  zipFileName String?
  zipFilePath String?

  posterCount Int?

  submissionSummary Json?

  error String?

  managedConferenceId String?

  completedAt DateTime?

  created DateTime @default(now())
  updated DateTime @updatedAt

  @@index([userId, updated])
  @@index([status])
}

model ExtractionBatch {
  id         String          @id @default(cuid(2))
  user       User            @relation(fields: [userId], references: [id])
  userId     String
  requestKey String
  name       String
  totalFiles Int
  jobs       ExtractionJob[]
  created    DateTime        @default(now())
  updated    DateTime        @updatedAt

  @@unique([userId, requestKey])
  @@index([userId, created])
}

model ExtractionJob {
  // This record and the files will only be removed after the poster is published or a doi is submitted
  id String @id @default(cuid(2))

  poster   Poster @relation(fields: [posterId], references: [id], onDelete: Cascade)
  posterId Int    @unique

  fileName String
  filePath String

  completed    Boolean          @default(false)
  // Existing jobs retain single priority. A bulk job always belongs to a batch.
  queueClass   String           @default("single")
  batch        ExtractionBatch? @relation(fields: [batchId], references: [id], onDelete: Restrict)
  batchId      String?
  batchIndex   Int?
  fileSize     Int?
  fileUploaded Boolean          @default(true)
  // pending-upload, uploading, pending-extraction, pending-thumbnail, processing, completed, failed
  status       String           @default("pending-extraction")
  error        String? // Filled when job fails

  created DateTime @default(now())
  updated DateTime @updatedAt

  @@unique([batchId, batchIndex])
  @@index([status])
  @@index([queueClass, completed, status, created])
}

model MaintenanceFlag {
  // One row per pausable workflow. A missing row means the workflow is live.
  // Keys are defined in shared/utils/maintenance.ts.
  key     String  @id
  enabled Boolean @default(false)
  message String  @default("") // Admin authored copy shown to users while paused

  enabledAt DateTime? // When the flag was most recently switched on

  updatedBy   User?   @relation("MaintenanceFlagUpdates", fields: [updatedById], references: [id])
  updatedById String?

  created DateTime @default(now())
  updated DateTime @updatedAt

  @@index([enabled])
}
