DATABASE_URL=postgresql://admin:root@localhost:5432/posters_science_local?sslmode=disable

SEED_USER_EMAIL=rick@example.com
NUXT_POSTER_EXTRACTION_API=
NUXT_ZENODO_ENDPOINT="https://sandbox.zenodo.org"
NUXT_ZENODO_API_ENDPOINT="https://sandbox.zenodo.org/api"
NUXT_ZENODO_CLIENT_ID=
NUXT_ZENODO_CLIENT_SECRET=
NUXT_ZENODO_REDIRECT_URI="http://localhost:3000/api/zenodo/callback"
# 32 random bytes as base64. Generate one with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
NUXT_ZENODO_TOKEN_ENCRYPTION_KEY=

# Publish to Figshare. Personal tokens work with the defaults below. For the
# Sign in with Figshare button, create an application at
# https://figshare.com/account/applications with this exact callback address
# (an application takes one callback, so dev, staging and production each need
# their own), then run `pnpm dev:https` and open https://127.0.0.1:3000
# Figshare has no public sandbox: anything published on figshare.com is public
# and stays public, so test up to the private item and delete it.
NUXT_FIGSHARE_ENDPOINT=https://figshare.com
NUXT_FIGSHARE_API_ENDPOINT=https://api.figshare.com/v2
NUXT_FIGSHARE_CLIENT_ID=
NUXT_FIGSHARE_CLIENT_SECRET=
NUXT_FIGSHARE_REDIRECT_URI=https://127.0.0.1:3000/api/figshare/callback
# Optional. Uses NUXT_ZENODO_TOKEN_ENCRYPTION_KEY when empty.
NUXT_FIGSHARE_TOKEN_ENCRYPTION_KEY=
# Outside production (NUXT_SITE_ENV is not "production") publishing stops at a
# private Figshare draft with its metadata and files. Set to true only to
# really publish from another site; published items can't be deleted.
NUXT_FIGSHARE_ALLOW_PUBLISH=false

# Sign in with ORCID. Leave empty to hide the button. Local development uses
# the sandbox. Register the client at https://sandbox.orcid.org/developer-tools
# with this exact redirect address, then run `pnpm dev:https` and open
# https://127.0.0.1:3000
NUXT_ORCID_ENDPOINT=https://sandbox.orcid.org
NUXT_ORCID_CLIENT_ID=
NUXT_ORCID_CLIENT_SECRET=
NUXT_ORCID_REDIRECT_URI=https://127.0.0.1:3000/api/auth/orcid

NUXT_SITE_ENV=development
NUXT_SITE_NAME=posters-science-dev
NUXT_SITE_URL=http://localhost:3000

NUXT_RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
NUXT_BUNNY_PRIVATE_STORAGE=
NUXT_BUNNY_PRIVATE_STORAGE_KEY=

# Logwatch channel URL: https://logwatch.fairdataihub.org/api/log/<channel id>
# Leave empty locally so logs only go to the console.
NUXT_LOGWATCH_URL=

# FEATURE FLAG (versioning): shows the user poster versioning workflow (hidden unless "true")
NUXT_PUBLIC_VERSIONING_ENABLED=true
# Comma-separated registered server features. Empty disables experimental entry points.
NUXT_FEATURES=bulk_extraction
