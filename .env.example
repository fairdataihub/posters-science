DATABASE_URL=postgresql://admin:root@localhost:5432/posters_science_local?sslmode=disable

SEED_USER_EMAIL=rick@example.com
NUXT_POSTER_EXTRACTION_API=
NUXT_ZENODO_ENDPOINT="https://sandbox.zenodo.org"
NUXT_ZENODO_API_ENDPOINT="https://sandbox.zenodo.org/api"
NUXT_ZENODO_CLIENT_ID=
NUXT_ZENODO_CLIENT_SECRET=
NUXT_ZENODO_REDIRECT_URI="http://localhost:3000/api/zenodo/callback"
# 32 random bytes as base64. Generate one with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
NUXT_ZENODO_TOKEN_ENCRYPTION_KEY=

# Sign in with ORCID. Leave empty to hide the button. Local development uses
# the sandbox, since production ORCID only accepts https redirect addresses.
# Register the client at https://sandbox.orcid.org/developer-tools with this
# exact redirect address.
NUXT_ORCID_ENDPOINT=https://sandbox.orcid.org
NUXT_ORCID_CLIENT_ID=
NUXT_ORCID_CLIENT_SECRET=
NUXT_ORCID_REDIRECT_URI=http://localhost:3000/api/auth/orcid

NUXT_SITE_ENV=development
NUXT_SITE_NAME=posters-science-dev
NUXT_SITE_URL=http://localhost:3000

NUXT_RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
NUXT_BUNNY_PRIVATE_STORAGE=
NUXT_BUNNY_PRIVATE_STORAGE_KEY=

# Logwatch channel URL: https://logwatch.fairdataihub.org/api/log/<channel id>
# Leave empty locally so logs only go to the console.
NUXT_LOGWATCH_URL=

# FEATURE FLAG (versioning): shows the user poster versioning workflow (hidden unless "true")
NUXT_PUBLIC_VERSIONING_ENABLED=true
# Comma-separated registered server features. Empty disables experimental entry points.
NUXT_FEATURES=bulk_extraction
